{
  "description": "CC voice companion - plays personality-driven audio on Claude Code events",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/bin/voice-buddy-hook",
          "args": [],
          "timeout": 5,
          "async": true
        }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/bin/voice-buddy-hook",
          "args": [],
          "timeout": 5,
          "async": true
        }]
      }
    ],
    "Notification": [
      {
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/bin/voice-buddy-hook",
          "args": [],
          "timeout": 5,
          "async": true
        }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/bin/voice-buddy-hook",
          "args": [],
          "timeout": 5,
          "async": false
        }]
      }
    ]
  }
}
